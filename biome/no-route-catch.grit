language js

or {
  `try { $body } catch ($err) { $handler }`,
  `try { $body } catch { $handler }`,
  `try { $body } catch ($err) { $handler } finally { $fin }`,
  `try { $body } catch { $handler } finally { $fin }`
} as $stmt where {
  register_diagnostic(span=$stmt, message="Routes do not catch: throw, or let the error propagate to the shared errorHandler (CODING_STANDARDS.md, section 'Routes throw, the error handler answers').")
}
