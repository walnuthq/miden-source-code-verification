{
  "name": "miden-source-code-verification-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api-compile": {
      "types": "./src/api-compile.ts",
      "development": "./src/api-compile.ts",
      "default": "./dist/api-compile.js"
    },
    "./api-registry": {
      "types": "./src/api-registry.ts",
      "development": "./src/api-registry.ts",
      "default": "./dist/api-registry.js"
    },
    "./http-errors": {
      "types": "./src/http-errors.ts",
      "development": "./src/http-errors.ts",
      "default": "./dist/http-errors.js"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "development": "./src/manifest.ts",
      "default": "./dist/manifest.js"
    },
    "./networks": {
      "types": "./src/networks.ts",
      "development": "./src/networks.ts",
      "default": "./dist/networks.js"
    },
    "./project": {
      "types": "./src/project.ts",
      "development": "./src/project.ts",
      "default": "./dist/project.js"
    },
    "./resource-id": {
      "types": "./src/resource-id.ts",
      "development": "./src/resource-id.ts",
      "default": "./dist/resource-id.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@scure/base": "2.4.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "express": "5.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
