{
  "name": "miden-source-code-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "test:pure": "pnpm --filter ./packages/utils --filter ./apps/web-viewer --filter ./apps/web-verifier test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test:pure",
    "watch-deploy": "node scripts/watch-deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
