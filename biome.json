{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!**/drizzle",
      "!**/components/ui",
      "!**/.agents",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.jsonc"],
      "json": {
        "formatter": {
          "trailingCommas": "all"
        }
      }
    },
    {
      "includes": [
        "apps/api-compile/**",
        "apps/api-registry/**",
        "apps/api-docs/**",
        "apps/status-page/scripts/**",
        "scripts/**",
        "packages/utils/**",
        "packages/test-utils/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api-compile/src/routes/**",
        "apps/api-registry/src/routes/**"
      ],
      "plugins": ["./biome/no-route-catch.grit"]
    }
  ]
}
