{
  "name": "miden-source-code-verification-api-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --conditions development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "exports": {
    "./app": {
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    },
    "./db": {
      "types": "./dist/src/db/index.d.ts",
      "default": "./dist/src/db/index.js"
    },
    "./storage": {
      "types": "./dist/src/storage/masp-store.d.ts",
      "default": "./dist/src/storage/masp-store.js"
    }
  },
  "dependencies": {
    "cors": "2.8.6",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "5.3.0",
    "miden-source-code-verification-utils": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "miden-source-code-verification-test-utils": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
