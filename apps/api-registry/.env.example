PORT=8081
ALLOWED_ORIGINS=*
DATABASE_URL="postgres://miden-source-code-verification:miden_source_code_verification_dev_password@localhost:5433/miden-source-code-verification"
API_COMPILE_URL=http://localhost:8080

# Directory of the filesystem store for compiled packages (compose: /data/masp).
# MASP_STORAGE_DIR=.masp

# Enables the /admin routes (debug-build backfill). Unset: they answer 404.
# ADMIN_TOKEN=

# Registry that scripts/backfill-debug-packages.ts calls, with ADMIN_TOKEN.
# REGISTRY_URL=http://localhost:8081
