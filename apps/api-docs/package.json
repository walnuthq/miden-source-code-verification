{
  "name": "miden-source-code-verification-api-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.ts",
    "preview": "sirv dist --port 8082",
    "dev": "node src/build.ts && sirv dist --port 8082 --dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-dist": "5.34.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-dist": "3.30.6",
    "sirv-cli": "3.0.1",
    "typescript": "7.0.2"
  }
}
