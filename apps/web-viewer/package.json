{
  "name": "miden-source-code-verification-web-viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./build/server/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b tsconfig.app.json tsconfig.node.json && react-router build",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-router/serve": "8.5.1",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "fflate": "0.8.3",
    "isbot": "5.2.3",
    "lucide-react": "1.72.0",
    "miden-source-code-verification-ui": "workspace:*",
    "miden-source-code-verification-utils": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
