# Cloudflare static-asset headers, copied into the app's build output by the
# cf:dev / cf:deploy scripts (kept identical in web-verifier-cloudflare and
# web-viewer-cloudflare).
#
# Vite content-hashes everything under /assets/, so a changed file always gets
# a new name: browsers can keep these for a year without revalidating. Anything
# else (HTML, favicon) keeps Cloudflare's default `max-age=0, must-revalidate`.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
