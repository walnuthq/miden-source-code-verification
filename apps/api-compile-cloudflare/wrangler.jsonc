/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "miden-source-code-verification-api-compile",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "PORT": "8080",
    "ALLOWED_ORIGINS": "*",
    "MIDEN_CLIENT_CACHE_DIR": "/cache/stores",
  },
  "containers": [
    {
      "class_name": "Compiler",
      "image": "../api-compile/Dockerfile",
      // api-compile is a pnpm workspace package whose Dockerfile builds from the
      // monorepo root (needs the workspace lockfile + apps/api-compile/* paths),
      // matching docker-compose's `context: .`. Default context is the
      // Dockerfile's dir, so point it at the repo root instead.
      "image_build_context": "../../",
      "max_instances": 1,
      // 1 vCPU, 6 GiB, 12 GB disk, chosen for cargo builds and their 1.6 GB
      // warm cache. Since cargo left (2026-11-26) a build assembles in ~40 ms
      // and the server peaked at ~31 MiB locally, on a 418 MB image: a smaller
      // type would do, not yet tried in production.
      "instance_type": "standard-2",
      // Next to the Miden nodes (gateway.fm, Lelystad NL), which every import
      // and verification calls several times. The Durable Object's
      // `locationHint` (src/server.ts) doesn't place the container.
      "constraints": { "regions": ["WEUR"] },
      "ssh": {
        "enabled": true,
      },
      /* add SSH public key when debugging with wrangler tail */
      /* "authorized_keys": [
        {
          "name": "id_ed25519",
          "public_key": "ssh-ed25519 PUBLIC_KEY EMAIL_ADDRESS",
        },
      ], */
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Compiler",
        "name": "COMPILER",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Compiler"],
      "tag": "v1",
    },
  ],
  "upload_source_maps": true,
}
