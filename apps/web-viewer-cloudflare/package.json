{
  "name": "miden-source-code-verification-web-viewer-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cf:typegen": "wrangler types",
    "cf:dev": "pnpm --filter miden-source-code-verification-web-viewer... build && cp _headers ../web-viewer/build/client/ && wrangler dev --port 5174",
    "cf:deploy": "VITE_WEB_VERIFIER_URL=https://miden-source-code-verification-web-verifier.walnut.dev pnpm --filter miden-source-code-verification-web-viewer... build && cp _headers ../web-viewer/build/client/ && wrangler deploy"
  },
  "dependencies": {
    "miden-source-code-verification-web-viewer": "workspace:*",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  }
}
