# Services probed at build time by scripts/probe.ts. In CI these come from the
# repository variables of the same name (see .github/workflows/deploy-pages.yml).
API_COMPILE_URL=http://localhost:8080
API_REGISTRY_URL=http://localhost:8081
WEB_VERIFIER_URL=http://localhost:5173

# Where the last published snapshot lives — the probe reads it to work out what
# changed since the previous run. Derived from the repository in CI; leave unset
# locally and every run simply starts without previous state, which is what keeps
# a local probe from posting a duplicate outage to the real channel.
# STATUS_PAGE_URL=https://walnuthq.github.io/miden-source-code-verification/status/

# Slack Incoming Webhook. Unset means scripts/notify.ts prints and posts nothing.
# In CI this is a repository *secret*, not a variable.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
