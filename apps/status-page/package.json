{
  "name": "miden-source-code-verification-status-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "build": "pnpm probe && pnpm typecheck && vite build",
    "dev": "pnpm probe && vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.28.0",
    "miden-source-code-verification-ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "miden-source-code-verification-test-utils": "workspace:*",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
