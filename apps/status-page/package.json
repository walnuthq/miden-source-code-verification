{
  "name": "miden-source-code-verification-status-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node --env-file-if-exists=.env scripts/probe.ts",
    "notify": "node --env-file-if-exists=.env scripts/notify.ts",
    "build": "pnpm probe && pnpm typecheck && vite build",
    "dev": "pnpm probe && vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "lucide-react": "1.69.0",
    "miden-source-code-verification-ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "miden-source-code-verification-test-utils": "workspace:*",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
